{
    "name": "libxvid",
    "description": "XVid decoder",
    "filters":["xviddec","rfmpgvid"],
    "help": "This filter decodes MPEG-4 part 2 (and DivX) through libxvidcore library.",
    "support": [
        "video"
    ],
    "sources":"https://codeload.github.com/Bevara/libxvid/zip/refs/heads/main",
    "filter_source":{
        "xviddec" : "dec_xvid.c",
        "rfmpgvid" : "reframe_mpegvid.c"
    },
    "Format": ["xvid","MPEG-4 Visual"],
    "using": ["solver_minimal_1", "solver_1"],
    "patents": {
        "status": "under-review",
        "note": "MPEG-4 Part 2: expiry of the last MPEG LA patents not verified",
        "checked": "2026-10-16"
    }
}
